# ─────────────────────────────────────────────────────────────────────────────
# RDP WebProxy Server Configuration
# Copy this file to .env and configure values before starting.
# ─────────────────────────────────────────────────────────────────────────────

# Server Port & Web Client Origin
PORT=3000
CLIENT_ORIGIN=http://localhost:3000

# Authentication & Security
ADMIN_PASSWORD=change_me_strong_admin_password
JWT_SECRET=change_me_jwt_secret_min_32_characters_long
AGENT_SECRET=change_me_agent_secret_token_min_32_chars
GUAC_CLIENT_KEY=change_me_32_byte_aes_key_here!!!

# Guacamole Daemon (guacd)
GUACD_HOST=127.0.0.1
GUACD_PORT=4822

# TCP Bridge Configuration
RDP_SECURITY=any
RDP_BRIDGE_BIND_HOST=0.0.0.0
RDP_BRIDGE_CONNECT_HOST=host.docker.internal

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Standalone Mode (Direct RDP without RdpHostAgent)
# Set STANDALONE_MODE=true if guacd connects directly to a target Windows RDP host.
# ─────────────────────────────────────────────────────────────────────────────
STANDALONE_MODE=false
# STANDALONE_RDP_HOST=127.0.0.1
# STANDALONE_RDP_PORT=3389
# STANDALONE_HOST_NAME=local-rdp
