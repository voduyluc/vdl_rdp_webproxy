# ─────────────────────────────────────────────────────────────────────────────
# Standalone Mode — proxy + web client + direct RDP in one process.
# No RdpHostAgent required. guacd connects directly to STANDALONE_RDP_HOST.
# Copy to .env and adjust values before starting.
# ─────────────────────────────────────────────────────────────────────────────

# Enable standalone mode (skips agent bridge, AGENT_SECRET not required)
STANDALONE_MODE=true

# Target RDP host that guacd will reach directly.
# Use 127.0.0.1 when the RDP machine is the same host running this server.
STANDALONE_RDP_HOST=127.0.0.1
STANDALONE_RDP_PORT=3389

# Display name for this host in the web UI
STANDALONE_HOST_NAME=local

# ─── Authentication ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_me_strong_password
JWT_SECRET=change_me_jwt_secret_min_32_chars_long

# ─── Guacamole ────────────────────────────────────────────────────────────────
GUACD_HOST=127.0.0.1
GUACD_PORT=4822
GUAC_CLIENT_KEY=change_me_32_char_aes_key_here!!!

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Allow the built-in web client (served from /client) — set to same origin
CLIENT_ORIGIN=http://localhost:3000

# Default RDP security mode (any | nla | tls | rdp | nla-ext | vmconnect)
RDP_SECURITY=any

# ─── Notes ────────────────────────────────────────────────────────────────────
# Start with:  npm start
# Web client:  http://localhost:3000/client
#
# NAT / port forwarding: expose port 3000 externally. No other ports needed.
# guacd must be running locally or in a container reachable from this host.
#   Docker:  docker run --rm -p 4822:4822 guacamole/guacd
